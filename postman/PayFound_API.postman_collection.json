            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Configuration received\",()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Nearby product discovery",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?in_stock=true&radius_km=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products?in_stock=true&radius_km=100"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let products=pm.response.json();pm.test(\"Products available\",()=>pm.expect(products.length).greaterThan(0));if(products.length){pm.collectionVariables.set(\"productId\",products[0].id);}"
                ]
              }
