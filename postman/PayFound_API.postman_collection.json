        {
          "name": "Sample stores and opening status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/merchants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "merchants"
              ]
            },
            "description": ""
