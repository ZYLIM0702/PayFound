              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\",pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserve sample product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-demo-role",
                "value": "consumer"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/reserve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "reserve"
              ]
            },
            "description": "Requires DEMO_MODE=true. If selected sample merchant is currently closed, choose a 24-hour sample store product.",
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\": \"{{productId}}\", \"quantity\": 1, \"idempotency_key\": \"{{idempotencyKey}}\", \"buyer_name\": \"Postman shopper\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Reservation created\",()=>pm.expect(pm.response.code).to.equal(201));if(pm.response.code===201)pm.collectionVariables.set(\"orderId\",pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-demo-role",
