{
  "info": {
    "name": "PayFound Prototype — API Smoke and Sandbox",
    "description": "Local demo flow plus OPTIONAL real PayPal sandbox. Import, set baseUrl=http://127.0.0.1:8000, run discovery→reserve→mock pay→merchant fulfilment. Do not run mock and real PayPal on the same order. Never store sandbox secrets in this Postman collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Health and discovery",
      "item": [
        {
          "name": "API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API online\",()=>pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Public configuration",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/config",
              "host": [
