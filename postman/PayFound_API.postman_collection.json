          "name": "Simulate payment — NO FUNDS MOVED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-demo-role",
                "value": "consumer"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/mock-pay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "mock-pay"
              ]
            },
            "description": "DO NOT USE with a real PayPal order. Endpoint disabled when DEMO_MODE=false.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Demo capture flagged\",()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().payment_mode).to.equal(\"demo\");});"
                ]
              }
            }
          ]
