# DEMO ONLY: x-demo-role headers and simulated funds. NEVER enable on a public deployment.
DEMO_MODE=true
DATABASE_URL=sqlite:///./payfound_demo.db
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Demo checkout uses a single sandbox seller beneficiary; not actual separate merchant settlement.
SUPABASE_PROJECT_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Use https://<project>.supabase.co/auth/v1/.well-known/jwks.json (asymmetric JWT)
SUPABASE_JWKS_URL=
CHANNEL3_API_KEY=
CHANNEL3_SEARCH_URL=https://api.trychannel3.com/v1/search
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: an access key in front of the whole app (blocks the public from using paid APIs). Empty = no gate.
SITE_ACCESS_KEY=

# Optional OpenAI-compatible LLM. Disabled by default: enable only with permitted data.
ENABLE_REMOTE_AI=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
AG_STUDIO_LICENSE_KEY=

# Root workspace .env is loaded explicitly. Existing names are supported:
# PAYPAL_PLATFORM_APP_CLIENT_ID -> PAYPAL_CLIENT_ID
# PAYPAL_PLATFORM_APP_SECRET_KEY -> PAYPAL_CLIENT_SECRET
# SUPABASE_URL -> SUPABASE_PROJECT_URL
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
PUBLIC_API_URL=http://127.0.0.1:8000
PUBLIC_WEB_URL=http://127.0.0.1:5173
# Generated by scripts/setup.py. Required for connector credential storage.
CONNECTOR_ENCRYPTION_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
LLM_PROVIDER=openai-compatible

# Google Maps / traffic-aware driving directions. The existing singular name
# GOOGLE_MAP_API_KEY is also supported for the loopback demo.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
DEMO_EXPANDED_CATALOGUE=true

# AI assistant (/agent). Without these the assistant reports "not configured".
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: live voice and dictation.
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_TRANSCRIBE_MODEL=
ASSISTANT_RUN_TIMEOUT_SECONDS=
# Optional: read-only PayPal MCP bridge for administrators.
ASSISTANT_PAYPAL_MCP=
