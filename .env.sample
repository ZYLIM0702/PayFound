# PayFound environment sample
#
# Copy the parts you need into real, git-ignored files:
#   apps/api/.env   server settings (everything except VITE_*)
#   apps/web/.env   browser settings (VITE_* only)
# `python scripts/setup.py` creates both for you and generates CONNECTOR_ENCRYPTION_KEY.
#
# Rules
#   - Never commit a filled-in copy. Only this sample is tracked.
#   - Secrets live server-side. Anything prefixed VITE_ is shipped to the browser, so it must be public-safe.
#   - Process environment wins over files. Leave a value blank to disable that feature.
#   - Legend: [required] to run that mode, [optional] unlocks a feature, [demo] local synthetic mode only.
#
# The local demo needs NONE of these: `python scripts/dev.py --demo` works with an empty .env.

# =============================================================================
# CORE
# =============================================================================
# [demo] true = fictional stores, role switcher, simulated checkout. Loopback only.
# MUST be false (or unset) on any public host.
DEMO_MODE=true

# [required for staging/production] Server-only SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host:5432/db?sslmode=require
# Unset in demo mode: a local SQLite file is used.
DATABASE_URL=

# [required for staging] Exact web origin(s), comma-separated. e.g. https://payfound.example.com
CORS_ORIGINS=
# [required for staging] Public origins, used for OAuth redirects and links.
PUBLIC_API_URL=
PUBLIC_WEB_URL=

# [required if you use WooCommerce/Shopify connectors] Encrypts connector credentials at rest.
# Generated by scripts/setup.py (Fernet key). Use the SAME value for the API and the worker, and keep it when redeploying.
CONNECTOR_ENCRYPTION_KEY=

# [optional] Honour verified proxy client-address headers (set true only behind a trusted proxy).
TRUST_PROXY_HEADERS=
# [optional] Public-mode request limits per minute (defaults 600 per IP, 120 per user).
API_PUBLIC_RATE_LIMIT_PER_MINUTE=
API_USER_RATE_LIMIT_PER_MINUTE=

# =============================================================================
# IDENTITY (Supabase) - required when DEMO_MODE=false
# =============================================================================
SUPABASE_PROJECT_URL=
# https://<project-id>.supabase.co/auth/v1/.well-known/jwks.json  (asymmetric signing keys)
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Public key returned to the browser by /api/config.
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose.
SUPABASE_SECRET_KEY=

# =============================================================================
# PAYPAL (sandbox only in this repository) - [optional] real sandbox checkout
# =============================================================================
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the HTTPS webhook you register for /api/paypal/webhook (needs a deployed public API URL).
PAYPAL_WEBHOOK_ID=
# Receiving-account configuration for the demo.
PAYPAL_MERCHANT_ID=
PAYPAL_PAYEE_MERCHANT_ID=
# Comma-separated sandbox receiving emails used to assign demo stores (optional).
PAYPAL_SANDBOX_POOL_CSV=
# A DISTINCT sandbox buyer for the wallet check. A seller cannot approve its own purchase.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# =============================================================================
# AI ASSISTANT - [optional] /agent
# =============================================================================
# Without these the assistant answers "not configured".
OPENAI_API_KEY=
OPENAI_MODEL=
# Live voice and dictation (all optional; sensible defaults apply when blank).
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=
OPENAI_TRANSCRIBE_MODEL=
# Run limit in seconds (default 90).
ASSISTANT_RUN_TIMEOUT_SECONDS=
# Read-only PayPal MCP bridge for administrators (true/false).
ASSISTANT_PAYPAL_MCP=
# Apply row-level-security context to assistant database reads (true/false).
ASSISTANT_DB_RLS=

# Optional merchant-intelligence inference. Disabled by default; needs the owner's consent for real data.
ENABLE_REMOTE_AI=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
LLM_MAX_COST_USD_PER_RUN=
LLM_DAILY_BUDGET_USD=
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=

# =============================================================================
# ONLINE OFFERS (Channel3) - [optional] ONLINE results beside local stock
# =============================================================================
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=
CHANNEL3_TIMEOUT_SECONDS=
CHANNEL3_RATE_LIMIT_PER_MINUTE=

# =============================================================================
# GOOGLE MAPS - [optional] map, live traffic and driving routes
# =============================================================================
# One general key is enough for the loopback demo. GOOGLE_MAP_API_KEY (singular) is also accepted.
GOOGLE_MAPS_API_KEY=
# Staging: use SEPARATE keys. A Routes-only key is never exposed to the browser.
GOOGLE_ROUTES_API_KEY=
# Referrer-restricted browser key for the map.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=

# =============================================================================
# CONNECTORS - [optional]
# =============================================================================
# Shopify app (Partners dashboard). Redirect URI: https://<api-origin>/api/connectors/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# =============================================================================
# ANALYTICS / UI LICENCES - [optional]
# =============================================================================
# AG Studio licence. Use your own; never commit a real key.
AG_STUDIO_LICENSE_KEY=

# =============================================================================
# DEMO TUNING - [demo]
# =============================================================================
# false = the small original fixture instead of the full demo catalogue.
DEMO_EXPANDED_CATALOGUE=
# Time zone for seeded pickup slots, e.g. Asia/Kuala_Lumpur.
DEMO_PICKUP_TZ=
# Location of the POS simulator's own journal database.
POS_SIMULATOR_DATABASE=
# Store-placement tuning (seconds / cells per hour). Defaults are fine.
PF_PLACEMENT_BUDGET_S=
PF_PLACEMENT_WAIT_S=
PF_PLACEMENT_MAX_CELLS_PER_HOUR=

# =============================================================================
# BROWSER (apps/web/.env) - public-safe values only
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only when the API is on a different origin than the web app (e.g. Render).
VITE_API_URL=
VITE_AG_STUDIO_LICENSE_KEY=
